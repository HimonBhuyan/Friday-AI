<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stark_black">

    <WebView
        android:id="@+id/fridayWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/stark_black" />

    <LinearLayout
        android:id="@+id/connectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        android:background="#E6050A12">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/connectionStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/connecting"
            android:textColor="@color/stark_cyan"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:gravity="center" />

        <EditText
            android:id="@+id/serverIpInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#2000F0FF"
            android:padding="14dp"
            android:hint="http://192.168.1.133:3000"
            android:textColorHint="#8000F0FF"
            android:textColor="@color/stark_cyan"
            android:textSize="15sp"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/stark_cyan"
            android:textColor="@color/stark_black"
            android:text="ENGAGE UPLINK"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
